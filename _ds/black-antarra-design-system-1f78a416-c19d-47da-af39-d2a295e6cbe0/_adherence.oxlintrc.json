        "selector": "JSXOpeningElement[name.name='CatCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:available|reserved|home|resident)$/]",
        "message": "<CatCard> status must be one of 'available' | 'reserved' | 'home' | 'resident'."
