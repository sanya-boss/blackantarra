{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/contact/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sentient|PT Serif|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Sentient, PT Serif, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdvantageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:illustration|title|text|artHeight|headingLevel|className|key|ref|className|style|children)$/]",
        "message": "<AdvantageCard> doesn't accept that prop. Declared props: illustration, title, text, artHeight, headingLevel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|animated|repeat|pauseLabel|className|key|ref|className|style|children)$/]",
        "message": "<BrandBand> doesn't accept that prop. Declared props: items, animated, repeat, pauseLabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|name|text|traits|photo|alt|focus|placeholder|ratio|action|headingLevel|className|key|ref|className|style|children)$/]",
        "message": "<BreedCard> doesn't accept that prop. Declared props: eyebrow, name, text, traits, photo, alt, focus, placeholder, ratio, action, headingLevel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreederCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|name|paragraphs|photo|alt|focus|placeholder|actions|headingLevel|className|key|ref|className|style|children)$/]",
        "message": "<BreederCard> doesn't accept that prop. Declared props: eyebrow, name, paragraphs, photo, alt, focus, placeholder, actions, headingLevel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|icon|iconPosition|loading|disabled|block|pressed|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, icon, iconPosition, loading, disabled, block, pressed, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|strong|secondary|text|on-photo)$/]",
        "message": "<Button> variant must be one of 'primary' | 'strong' | 'secondary' | 'text' | 'on-photo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|l)$/]",
        "message": "<Button> size must be one of 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<Button> iconPosition must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|breed|meta|caption|photo|alt|focus|placeholder|ratio|status|lang|href|onClick|headingLevel|className|key|ref|className|style|children)$/]",
        "message": "<CatCard> doesn't accept that prop. Declared props: name, breed, meta, caption, photo, alt, focus, placeholder, ratio, status, lang, href, onClick, headingLevel, className."
