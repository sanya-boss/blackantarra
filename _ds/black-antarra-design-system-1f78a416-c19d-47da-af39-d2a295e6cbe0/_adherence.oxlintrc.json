      {
        "selector": "JSXOpeningElement[name.name='CatCard'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:et|en|ru)$/]",
        "message": "<CatCard> lang must be one of 'et' | 'en' | 'ru'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|phone|email|person|personRole|social|mapSrc|mapTitle|mapFallbackTitle|mapFallbackText|extra|headingLevel|className|key|ref|className|style|children)$/]",
        "message": "<ContactBlock> doesn't accept that prop. Declared props: title, phone, email, person, personRole, social, mapSrc, mapTitle, mapFallbackTitle, mapFallbackText, extra, headingLevel, className."
